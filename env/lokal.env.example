# Templat env "lokal" untuk pawonee-backend-service dan pawonee-data-pipeline.
# SALIN ke env/lokal.env (diabaikan git), isi nilai nyata, JANGAN commit.
# Nilai nyata untuk staging/produksi disimpan di secret manager / GitHub Environment "lokal", bukan di berkas.

# Postgres 16.x, DB logis "pawonee" (satu DB per service; jangan arahkan ke DB divisi lain).
POSTGRES_PASSWORD=GANTI_PASSWORD_DB
DATABASE_URL=postgres://pawonee:GANTI_PASSWORD_DB@db:5432/pawonee

# Penandatangan JWT (akses 15 menit + refresh 7 hari, audiens "pawonee"). Minimal 32 karakter acak.
# Bangkitkan: openssl rand -base64 48
JWT_RAHASIA=GANTI_ACAK_MINIMAL_32_KARAKTER_XXXXXXXX

# Adaptor stok Pedaree (hanya baca). Service key server-ke-server, least-privilege, rotasi 90 hari
# (docs/runbook/rotasi-secret.md). Kosong = GET /v1/stok membalas 502.
PEDAREE_BASE_URL=http://host.docker.internal:8090
PEDAREE_SERVICE_KEY=GANTI_SERVICE_KEY_PEDAREE

# Opsional
ALAMAT=0.0.0.0:8080
TIMEOUT_DETIK=15
RUST_LOG=info
